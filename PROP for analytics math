# --- SECTION 2: IMPLEMENTING THE THREE MODELS ---

def run_model_a(df_curr):
    """
    Model A: Spatial Cross-District Min-Max Normalization (Current PoC).
    Scales variables across all 9 districts for the current week/month.
    """
    df = df_curr.copy()
    
    # Min-max normalization helper
    def scale_min_max(series, invert=False):
        s_min, s_max = series.min(), series.max()
        if s_min == s_max:
            return pd.Series(50.0, index=series.index)
        scaled = (series - s_min) / (s_max - s_min) * 100.0
        return 100.0 - scaled if invert else scaled

    # Invert precipitation, NDVI, and SM because lower values mean HIGHER stress
    df["ndvi_score"] = scale_min_max(df["ndvi"], invert=True)
    df["precip_score"] = scale_min_max(df["precip"], invert=True)
    df["sm_score"] = scale_min_max(df["sm"], invert=True)
    # LST is NOT inverted because higher LST means HIGHER stress
    df["lst_score"] = scale_min_max(df["lst"], invert=False)
    
    # Calculate weighted CDI (40% Precip, 20% NDVI, 20% LST, 20% SM)
    df["cdi_score"] = (
        0.40 * df["precip_score"] +
        0.20 * df["ndvi_score"] +
        0.20 * df["lst_score"] +
        0.20 * df["sm_score"]
    )
    return df[["district", "precip_score", "ndvi_score", "lst_score", "sm_score", "cdi_score"]]


def run_model_b(df_curr, df_hist):
    """
    Model B: Vegetation Health Index (VHI) (Climatological Min-Max).
    Scales current observations against local, historical maximum and minimum extremes.
    """
    df = df_curr.copy()
    
    # Aggregate historical extremes per district
    hist_bounds = df_hist.groupby("district").agg(
        ndvi_min=("ndvi", "min"),
        ndvi_max=("ndvi", "max"),
        lst_min=("lst", "min"),
        lst_max=("lst", "max")
    ).reset_index()
    
    df = pd.merge(df, hist_bounds, on="district")
    
    # Vegetation Condition Index (VCI)
    df["vci"] = (df["ndvi"] - df["ndvi_min"]) / (df["ndvi_max"] - df["ndvi_min"]) * 100.0
    # Thermal Condition Index (TCI) - inverted because higher temperatures mean more stress
    df["tci"] = (df["lst_max"] - df["lst"]) / (df["lst_max"] - df["lst_min"]) * 100.0
    
    # Clip indices to 0-100 boundary in case current observations exceed historical extremes
    df["vci"] = df["vci"].clip(0.0, 100.0)
    df["tci"] = df["tci"].clip(0.0, 100.0)
    
    # Vegetation Health Index (VHI) (standard equal weight configuration)
    df["vhi_score"] = 0.5 * df["vci"] + 0.5 * df["tci"]
    
    # Invert VHI to match "Higher Score = More Stress" convention
    df["vhi_stress"] = 100.0 - df["vhi_score"]
    
    return df[["district", "vci", "tci", "vhi_stress"]]


def run_model_c(df_curr, df_hist):
    """
    Model C: Weighted Standardized Climatological Anomalies (Recommended Z-Scores).
    Translates physical variables into standard deviations from local historical means.
    """
    df = df_curr.copy()
    
    # Calculate historical means and standard deviations
    hist_stats = df_hist.groupby("district").agg(
        ndvi_mean=("ndvi", "mean"),
        ndvi_std=("ndvi", "std"),
        lst_mean=("lst", "mean"),
        lst_std=("lst", "std"),
        sm_mean=("sm", "mean"),
        sm_std=("sm", "std"),
        precip_mean=("precip", "mean"),
        precip_std=("precip", "std")
    ).reset_index()
    
    df = pd.merge(df, hist_stats, on="district")
    
    # Calculate Z-scores for each parameter
    df["z_ndvi"] = (df["ndvi"] - df["ndvi_mean"]) / df["ndvi_std"]
    df["z_lst"] = (df["lst"] - df["lst_mean"]) / df["lst_std"]
    df["z_sm"] = (df["sm"] - df["sm_mean"]) / df["sm_std"]
    df["z_precip"] = (df["precip"] - df["precip_mean"]) / df["precip_std"]
    
    # Composite Standardized Anomaly Index (Z-CDI)
    # LST is subtracted because positive temperature anomalies signify heat stress
    df["z_cdi"] = (
        0.40 * df["z_precip"] +
        0.20 * df["z_ndvi"] -
        0.20 * df["z_lst"] +
        0.20 * df["z_sm"]
    )
    
    # Map Z-scores to a 0-100% Stress Scale for easier visualization
    # Where Z <= -2.0 represents 100% (Extreme Stress) and Z >= 0 represents 0% (No Stress)
    df["z_cdi_stress_pct"] = df["z_cdi"].apply(
        lambda z: min(100.0, max(0.0, (z / -2.0) * 100.0)) if z < 0 else 0.0
    )
    
    return df[["district", "z_ndvi", "z_lst", "z_sm", "z_precip", "z_cdi", "z_cdi_stress_pct"]]


# --- SECTION 3: RUN AND CONTRAST MODELS ---

results_a = run_model_a(df_current)
results_b = run_model_b(df_current, df_history)
results_c = run_model_c(df_current, df_history)

# Combine results for side-by-side comparison
df_compare = pd.merge(results_a[["district", "cdi_score"]], results_b[["district", "vhi_stress"]], on="district")
df_compare = pd.merge(df_compare, results_c[["district", "z_cdi", "z_cdi_stress_pct"]], on="district")

# Map to categorical risk classifications
def get_risk_category_a(score):
    if score >= 75.0: return "Extreme Stress"
    elif score >= 50.0: return "Severe Stress"
    elif score >= 25.0: return "Watch"
    else: return "Normal"

def get_risk_category_c(z):
    if z <= -2.0: return "Extreme Stress"
    elif z <= -1.5: return "Severe Stress"
    elif z <= -1.0: return "Watch"
    else: return "Normal"

df_compare["Model_A_Risk"] = df_compare["cdi_score"].apply(get_risk_category_a)
df_compare["Model_C_Risk"] = df_compare["z_cdi"].apply(get_risk_category_c)

